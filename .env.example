# Copy to .env.local and adjust. .env.local is git-ignored.
# Paths are absolute, relative to this app folder, or start with ~/.

# The folder that holds your campaigns, one subfolder each. It can start empty:
# create campaigns from the app.
CAMPAIGNS_DIR=~/campaigns

# Or open a single campaign folder, made from the DM-Second-Brain template (it holds
# wiki/ and raw/). When set, it wins over CAMPAIGNS_DIR.
# VAULT_PATH=../my-campaign

# World Studio AI (optional). Or run `ant auth login` instead of setting a key.
# ANTHROPIC_API_KEY=
# With a user-level key (sk-ant-usr…), also name the workspace to bill (Console → Settings → Workspaces):
# ANTHROPIC_WORKSPACE_ID=
# STUDIO_MODEL=claude-opus-5
